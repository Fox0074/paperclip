FROM ghcr.io/paperclipai/paperclip@sha256:de762433b50d56ed9180fef96a13fa236b37856c5c7a7718e8f19afe3d1e8670
USER root
RUN apt-get update && apt-get install -y --no-install-recommends openssh-server \
    && mkdir -p /run/sshd && passwd -d node \
    && printf '\nPasswordAuthentication no\nKbdInteractiveAuthentication no\nPermitRootLogin no\nAllowUsers node\n' >> /etc/ssh/sshd_config
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/bin/sh", "-c", "ssh-keygen -A && /usr/sbin/sshd -D -e"]
