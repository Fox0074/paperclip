# Application-only overlay. Keep the unchanged native runner from the official image.
FROM ghcr.io/paperclipai/paperclip@sha256:de762433b50d56ed9180fef96a13fa236b37856c5c7a7718e8f19afe3d1e8670
ARG PAPERCLIP_BUILD_COMMIT
ENV PAPERCLIP_BUILD_COMMIT=${PAPERCLIP_BUILD_COMMIT}
WORKDIR /app
COPY --chown=node:node packages/shared/src/index.ts /app/packages/shared/src/index.ts
COPY --chown=node:node packages/shared/src/types/index.ts packages/shared/src/types/execution-preset.ts /app/packages/shared/src/types/
COPY --chown=node:node packages/shared/src/validators/agent.ts /app/packages/shared/src/validators/agent.ts
COPY --chown=node:node server/src/routes/agents.ts /app/server/src/routes/agents.ts
COPY --chown=node:node server/src/services/execution-presets.ts /app/server/src/services/execution-presets.ts
COPY --chown=node:node ui/src/api/agents.ts /app/ui/src/api/agents.ts
COPY --chown=node:node ui/src/components/new-agent/NewAgentSetup.tsx /app/ui/src/components/new-agent/NewAgentSetup.tsx
RUN pnpm --filter @paperclipai/shared build \
    && pnpm --filter @paperclipai/server exec tsc \
    && pnpm --filter @paperclipai/ui build \
    && node server/scripts/write-build-stamp.mjs
